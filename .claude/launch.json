{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "damas-api",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m", "uvicorn", "--factory", "damas_ai.api.app:create_app",
        "--app-dir", "backend/src", "--host", "127.0.0.1", "--port", "8765"
      ],
      "env": {
        "DAMAS_ENGINES_CONFIG": "config/engines.toml",
        "DAMAS_DATABASE_URL": "sqlite:///var/damas_kb.sqlite3",
        "DAMAS_LOG_LEVEL": "INFO"
      },
      "port": 8765
    },
    {
      "name": "damas-ui",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend/damas-ui", "start"],
      "port": 4200
    }
  ]
}
